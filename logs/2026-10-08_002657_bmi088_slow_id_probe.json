  "executed_source": "import collections, datetime, json, pathlib, platform, time\nimport spidev\nclock = pathlib.Path('/sys/kernel/debug/bpmp/debug/clk/spi1')\ndef state():\n    return {name:(clock/name).read_text().strip() for name in ('parent','rate','possible_parents')}\noriginal = state()\nresult = {'started_at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(), 'host':platform.node(), 'kernel':platform.release(), 'test':'BMI088 retry after owner says IMU ready; fresh command per read; temporary clk_m parent', 'wiring':'Owner says IMU ready; wiring changes and board-side voltages not independently inspected', 'clock_note':'BPMP reported clock; no oscilloscope measurement', 'before':original, 'cases':[]}\nhandles=[]\ntry:\n    assert 'clk_m' in original['possible_parents'].split(), original\n    (clock/'parent').write_text('clk_m\\n')\n    result['after_parent_change']=state()\n    for mode in (0,3):\n        for requested in (100000,500000,1000000):\n            handles=[]\n            for cs in (0,1):\n                spi=spidev.SpiDev(); spi.open(0,cs); handles.append(spi)\n                spi.mode=mode; spi.max_speed_hz=requested\n            dummy=handles[0].xfer2([0x80,0,0]); time.sleep(.01)\n            case={'mode':mode,'requested_hz':requested,'accel_spi_selection_rx':dummy,'chips':[]}\n            for cs,tx,expected in ((0,(0x80,0,0),0x1e),(1,(0x80,0),0x0f)):\n                rows=[]\n                for i in range(20):\n                    rows.append(list(handles[cs].xfer2(list(tx)))); time.sleep(.005)\n                case['chips'].append({'cs':cs,'tx':list(tx),'expected_id':expected,'rx':rows,'matches':sum(r[-1]==expected for r in rows),'clock':state()})\n            result['cases'].append(case)\n            for spi in handles: spi.close()\n            handles=[]\nexcept Exception as exc:\n    result['error']=repr(exc)\nfinally:\n    for spi in handles:\n        try: spi.close()\n        except Exception: pass\n    errors=[]\n    for name in ('parent','rate'):\n        try: (clock/name).write_text(original[name]+'\\n')\n        except Exception as exc: errors.append(name+': '+repr(exc))\n    result['restoration_errors']=errors\n    result['restored']=state()\n    result['restoration_verified']=all(result['restored'][name]==original[name] for name in ('parent','rate'))\n    result['finished_at_utc']=datetime.datetime.now(datetime.timezone.utc).isoformat()\nprint(json.dumps(result))\n",
