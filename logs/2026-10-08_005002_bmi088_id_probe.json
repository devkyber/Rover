  "executed_source": "import collections, datetime, importlib.metadata, json, pathlib, platform, time\nimport spidev\nreport={'started_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'hostname':platform.node(),'kernel':platform.release(),'spidev_version':importlib.metadata.version('spidev'),'scope':'BMI088 chip-ID reads only; user says IMU ready; physical wiring/voltage not independently inspected','clock_note':'requested Hz; actual wire clock not measured','cases':[]}\nfor mode in (3,0):\n    for speed in (1000000,5000000):\n        handles=[]\n        try:\n            for cs in (0,1):\n                spi=spidev.SpiDev(); spi.open(0,cs); handles.append(spi)\n                spi.mode=mode; spi.max_speed_hz=speed; spi.bits_per_word=8; spi.lsbfirst=False; spi.cshigh=False\n            handles[0].xfer2([0x80,0,0]); time.sleep(.01)\n            for cs,command,expected in ((0,(0x80,0,0),0x1e),(1,(0x80,0),0x0f)):\n                rows=[]\n                for i in range(20):\n                    rows.append(list(handles[cs].xfer2(list(command)))); time.sleep(.005)\n                report['cases'].append({'cs':cs,'mode':mode,'requested_hz':speed,'tx':list(command),'expected_id':expected,'rx':rows,'valid_ids':sum(row[-1]==expected for row in rows)})\n        finally:\n            for spi in handles: spi.close()\nreport['finished_utc']=datetime.datetime.now(datetime.timezone.utc).isoformat()\nprint(json.dumps(report))\n",
